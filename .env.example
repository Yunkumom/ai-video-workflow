# ============================================================
# AI Video Workflow — Environment Variables
# ============================================================
#
# Copy this file:
#
#   cp env.example .env
#
# Then add your real API keys to .env.
#
# NEVER put real API keys in this file.
# ============================================================


# ------------------------------------------------------------
# GROQ
# Fast LLM inference / Whisper transcription
# ------------------------------------------------------------

GROQ_API_KEY=


# ------------------------------------------------------------
# OPENAI
# GPT / Whisper / image / multimodal processing
# ------------------------------------------------------------

OPENAI_API_KEY=


# ------------------------------------------------------------
# GOOGLE GEMINI
# Multimodal AI / video and image understanding
# ------------------------------------------------------------

GEMINI_API_KEY=


# ------------------------------------------------------------
# ANTHROPIC
# Claude models
# ------------------------------------------------------------

ANTHROPIC_API_KEY=


# ------------------------------------------------------------
# DEEPGRAM
# Speech-to-text / transcription
# ------------------------------------------------------------

DEEPGRAM_API_KEY=


# ------------------------------------------------------------
# ASSEMBLYAI
# Speech-to-text / subtitle generation
# ------------------------------------------------------------

ASSEMBLYAI_API_KEY=


# ------------------------------------------------------------
# ELEVENLABS
# Text-to-speech / AI voice
# ------------------------------------------------------------

ELEVENLABS_API_KEY=


# ------------------------------------------------------------
# REPLICATE
# AI image / video models
# ------------------------------------------------------------

REPLICATE_API_TOKEN=


# ------------------------------------------------------------
# HUGGING FACE
# Open-source AI models
# ------------------------------------------------------------

HUGGINGFACE_API_TOKEN=


# ============================================================
# AI VIDEO GENERATION — OPTIONAL
# Generative video, motion synthesis & fast media inference
# ============================================================

# Runway (Gen-2 / Gen-3 Alpha video generation)
RUNWAYML_API_SECRET=

# Luma Dream Machine (Realistic video motion)
LUMA_API_KEY=

# Kling AI (High-fidelity text-to-video / image-to-video)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Fal.ai (Ultra-fast Flux, diffusion & video pipelines)
FAL_KEY=


# ============================================================
# AI MUSIC & AUDIO — OPTIONAL
# BGM, soundtrack generation & audio soundscapes
# ============================================================

# Suno AI (Generative background music & song synthesis)
SUNO_API_KEY=


# ============================================================
# STORAGE — OPTIONAL
# Cloud media storage, asset hosting & backups
# ============================================================

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=


# ============================================================
# DATABASE — OPTIONAL
# Remote project sync, user profiles & review state
# ============================================================

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ============================================================
# SOCIAL MEDIA & PUBLISHING — OPTIONAL
# Automated social distribution, queue runner & channel uploads
# ============================================================

# YouTube / Google Cloud
YOUTUBE_API_KEY=
GOOGLE_CLIENT_SECRETS_FILE=

# Instagram / Meta
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=


# ============================================================
# APPLICATION SETTINGS
# These are NOT secrets.
# ============================================================

APP_ENV=development

INPUT_DIR=1_input
PROCESSING_DIR=2_processing
OUTPUT_DIR=3_output

LOG_LEVEL=INFO
